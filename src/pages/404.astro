---
import BaseLayout from "~/layouts/BaseLayout.astro";
import Header from "~/components/Header.astro";
import Footer from "~/components/Footer.astro";
import site from "~/data/site.json";
---

<BaseLayout title={`Page not found — ${site.brand}`} description="The page you were looking for couldn't be found." path="/404">
  <Header />
  <main id="main" class="notfound">
    <div class="container notfound__inner">
      <span class="notfound__code">404</span>
      <h1>This page took a wrong turn.</h1>
      <p>
        Don't worry — even the most pleasant personalities get lost sometimes. Head back home
        or jump straight to the enquiry form.
      </p>
      <div class="notfound__ctas">
        <a class="btn btn--primary" href="/">Back to home</a>
        <a class="btn btn--ghost" href="/#enquire">Send an enquiry</a>
      </div>
    </div>
  </main>
  <Footer />
</BaseLayout>

<style>
  .notfound {
    padding-block: clamp(4rem, 10vw, 8rem);
    background: linear-gradient(180deg, var(--color-cream) 0%, var(--color-cream-2) 100%);
    text-align: center;
  }
  .notfound__inner {
    max-width: 560px;
    margin-inline: auto;
  }
  .notfound__code {
    font-family: var(--font-heading);
    font-size: clamp(4rem, 12vw, 7rem);
    font-weight: 800;
    color: var(--color-accent);
    line-height: 1;
    display: block;
    margin-bottom: .5rem;
  }
  .notfound h1 { margin-bottom: 1rem; }
  .notfound p { color: var(--color-text-muted); margin-bottom: 2rem; }
  .notfound__ctas {
    display: inline-flex;
    flex-wrap: wrap;
    gap: .75rem;
    justify-content: center;
  }
</style>
