---
import gallery from "~/data/gallery.json";
import Icon from "./Icon.astro";
---

<section class="section section--alt" id="gallery">
  <div class="container">
    <div class="reveal">
      <span class="section-eyebrow">Gallery</span>
      <h2 class="section-title">Transformations & success stories</h2>
      <p class="section-intro">
        Moments from workshops, stage performances, coaching sessions and proud milestones —
        a glimpse of the journeys that happen at the academy.
      </p>
    </div>

    <div
      class="slider reveal"
      id="gallerySlider"
      data-autoplay="5000"
      aria-roledescription="carousel"
      aria-label="Academy photo gallery"
    >
      <div class="slider__track" id="sliderTrack">
        {gallery.map((g, i) => (
          <figure
            class="slide"
            data-slide
            role="group"
            aria-roledescription="slide"
            aria-label={`${i + 1} of ${gallery.length}`}
          >
            <img
              src={g.image}
              alt={g.caption}
              loading={i === 0 ? "eager" : "lazy"}
              decoding="async"
            />
            <figcaption class="slide__caption">{g.caption}</figcaption>
          </figure>
        ))}
      </div>

      <button class="slider__arrow slider__arrow--prev" id="sliderPrev" type="button" aria-label="Previous image">
        <Icon name="arrow-right" size={22} />
      </button>
      <button class="slider__arrow slider__arrow--next" id="sliderNext" type="button" aria-label="Next image">
        <Icon name="arrow-right" size={22} />
      </button>

      <div class="slider__dots" id="sliderDots" role="tablist" aria-label="Choose image"></div>
    </div>
  </div>
</section>

<style>
  .slider {
    position: relative;
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow);
    background: var(--color-primary);
    aspect-ratio: 16 / 9;
  }
  @media (min-width: 800px) {
    .slider { aspect-ratio: 21 / 9; }
  }
  .slider__track {
    display: flex;
    height: 100%;
    transition: transform .6s var(--ease);
  }
  .slide {
    position: relative;
    flex: 0 0 100%;
    height: 100%;
    margin: 0;
  }
  .slide img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .slide__caption {
    position: absolute;
    left: 0; right: 0; bottom: 0;
    padding: 3rem 1.5rem 1.25rem;
    color: var(--color-cream);
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 1.05rem;
    background: linear-gradient(to top, rgba(15, 76, 92, 0.85), transparent);
  }

  .slider__arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 46px; height: 46px;
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--color-primary);
    background: rgba(255, 250, 243, 0.85);
    box-shadow: var(--shadow-sm);
    transition: background .2s var(--ease), transform .2s var(--ease);
    z-index: 2;
  }
  .slider__arrow:hover { background: var(--color-cream); }
  .slider__arrow--prev { left: 1rem; }
  .slider__arrow--prev :global(svg) { transform: rotate(180deg); }
  .slider__arrow--next { right: 1rem; }

  .slider__dots {
    position: absolute;
    left: 0; right: 0; bottom: 1.1rem;
    display: flex;
    justify-content: center;
    gap: .5rem;
    z-index: 2;
  }
  .slider__dot {
    width: 10px; height: 10px;
    border-radius: 50%;
    padding: 0;
    background: rgba(255, 250, 243, 0.5);
    transition: background .2s var(--ease), transform .2s var(--ease);
  }
  .slider__dot[aria-selected="true"] {
    background: var(--color-accent);
    transform: scale(1.2);
  }
</style>

<script>
  const slider = document.getElementById("gallerySlider");
  const track = document.getElementById("sliderTrack");
  const dotsWrap = document.getElementById("sliderDots");
  const prevBtn = document.getElementById("sliderPrev");
  const nextBtn = document.getElementById("sliderNext");

  if (slider && track && dotsWrap) {
    const slides = Array.from(track.querySelectorAll<HTMLElement>("[data-slide]"));

    // Randomise slide order on each load ("random images slider").
    for (let i = slides.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      track.insertBefore(slides[i], slides[j].nextSibling);
    }
    const ordered = Array.from(track.querySelectorAll<HTMLElement>("[data-slide]"));

    let index = 0;
    const count = ordered.length;

    // Build dots
    const dots: HTMLButtonElement[] = ordered.map((_, i) => {
      const dot = document.createElement("button");
      dot.type = "button";
      dot.className = "slider__dot";
      dot.setAttribute("role", "tab");
      dot.setAttribute("aria-label", `Go to image ${i + 1}`);
      dot.addEventListener("click", () => go(i, true));
      dotsWrap.appendChild(dot);
      return dot;
    });

    const render = () => {
      track.style.transform = `translateX(-${index * 100}%)`;
      dots.forEach((d, i) => d.setAttribute("aria-selected", i === index ? "true" : "false"));
    };

    const go = (i: number, user = false) => {
      index = (i + count) % count;
      render();
      if (user) restart();
    };
    const next = (user = false) => go(index + 1, user);
    const prev = (user = false) => go(index - 1, user);

    nextBtn?.addEventListener("click", () => next(true));
    prevBtn?.addEventListener("click", () => prev(true));

    // Keyboard support
    slider.addEventListener("keydown", (e) => {
      if (e.key === "ArrowRight") { e.preventDefault(); next(true); }
      if (e.key === "ArrowLeft") { e.preventDefault(); prev(true); }
    });

    // Autoplay with pause on hover / focus / tab-hidden
    const interval = Number(slider.dataset.autoplay) || 5000;
    let timer: number | undefined;
    const start = () => {
      if (count < 2) return;
      timer = window.setInterval(() => next(false), interval);
    };
    const stop = () => { if (timer) window.clearInterval(timer); timer = undefined; };
    const restart = () => { stop(); start(); };

    slider.addEventListener("mouseenter", stop);
    slider.addEventListener("mouseleave", start);
    slider.addEventListener("focusin", stop);
    slider.addEventListener("focusout", start);
    document.addEventListener("visibilitychange", () => (document.hidden ? stop() : start()));

    render();
    start();
  }
</script>
